---
import BaseLayout from './BaseLayout.astro';
import type { ProjectMeta } from '../data/projects';
import { getLogoForSkill } from '../data/techLogos';

interface Props {
  project: ProjectMeta;
}

const { project } = Astro.props;
const title = `${project.title} — ${project.subtitle} | Shreyas`;
---

<BaseLayout title={title} description={project.description}>
  <!-- Back link -->
  <div class="container-content pt-10 pb-2">
    <a
      href="/projects/"
      class="inline-flex items-center gap-1.5 text-sm font-mono accent-hover"
      style="color: var(--text-muted);"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      All projects
    </a>
  </div>

  <!-- Header -->
  <header class="container-article pt-8 pb-10">
    <div class="mb-3">
      <span class="section-label">{project.categoryLabel}</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-semibold mb-3">{project.title}</h1>
    <p class="text-lg mb-6" style="color: var(--text-secondary);">{project.subtitle}</p>
    <p class="mb-6" style="color: var(--text-secondary);">{project.description}</p>

    <!-- Tech tags -->
    <div class="flex flex-wrap gap-2 mb-6">
      {project.technologies.map(tech => (
        <span class="tech-tag tech-tag-logo">
          {getLogoForSkill(tech) && <svg viewBox={getLogoForSkill(tech)?.viewBox ?? '0 0 24 24'} aria-hidden="true" set:html={getLogoForSkill(tech)?.svgPath ?? ''} />}
          {tech}
        </span>
      ))}
    </div>

    <!-- Actions -->
    <div class="flex flex-wrap gap-3">
      {project.repositoryLinkEnabled && (
        <a
          href={project.repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded text-sm font-medium transition-colors duration-200"
          style="background: var(--bg-elevated); border: 1px solid var(--border); color: var(--text-secondary);"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
            <path d="M9 18c-4.51 2-5-2-7-2"/>
          </svg>
          View source
        </a>
      )}
    </div>

  </header>

  <hr style="border-color: var(--border);" />

  <!-- Case study content -->
  <article class="container-article py-12 prose-case">
    <slot />
  </article>

  <!-- Limitations -->
  {false && (
    <section class="container-article pb-12">
      <h2 class="text-base font-semibold font-mono mb-3" style="color: var(--text-muted);">Known limitations</h2>
      <ul class="space-y-1.5">
        {project.limitations.map(l => (
          <li class="flex items-start gap-2 text-sm" style="color: var(--text-muted);">
            <span class="mt-1 shrink-0" style="color: var(--border);">—</span>
            {l}
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
