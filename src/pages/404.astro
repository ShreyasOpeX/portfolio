---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page not found | Shreyas" description="Page not found.">
  <div class="container-article py-32 text-center">
    <p class="font-mono text-sm mb-4" style="color: var(--accent);">404</p>
    <h1 class="text-3xl font-semibold mb-4">Page not found</h1>
    <p class="mb-8" style="color: var(--text-secondary);">
      This page doesn't exist or was moved.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm transition-colors duration-200"
      style="color: var(--text-secondary);"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      Back to home
    </a>
  </div>
</BaseLayout>
