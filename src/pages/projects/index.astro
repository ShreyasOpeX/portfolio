---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFeaturedProjects, getLaboratoryProjects } from '../../data/projects';
import { getLogoForSkill } from '../../data/techLogos';

const featured = getFeaturedProjects();
const labs = getLaboratoryProjects();
---

<BaseLayout
  title="Projects — Shreyas"
  description="Engineering projects by Shreyas: TradeSentry (event-driven AML), MediSureAI (agentic RAG), PRISM, HelpLens, RouteX and SentinelHub."
>
  <div class="container-content py-16 sm:py-24">

    <!-- Header -->
    <div class="max-w-2xl mb-16">
      <p class="section-label mb-4">Projects</p>
      <h1 class="text-3xl sm:text-4xl font-semibold mb-5">Engineering work</h1>
      <p style="color: var(--text-secondary);">
        A mix of flagship systems built to explore real-world patterns, and focused engineering laboratories for learning specific backend technologies.
      </p>
    </div>

    <!-- Featured projects -->
    <section class="mb-16">
      <h2 class="text-xs font-mono uppercase tracking-widest mb-6" style="color: var(--text-muted);">Flagship projects</h2>
      <div class="space-y-5">
        {featured.map(project => (
          <a
            href={`/projects/${project.slug}/`}
            class="block p-5 sm:p-6 rounded-lg transition-colors duration-200"
            style="background: var(--bg-secondary); border: 1px solid var(--border);"
          >
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <span class="section-label text-xs">{project.categoryLabel}</span>
                </div>
                <h3 class="text-lg font-semibold mb-1">{project.title}</h3>
                <p class="text-sm mb-3" style="color: var(--text-secondary);">{project.subtitle}</p>
                <p class="text-sm leading-relaxed mb-4" style="color: var(--text-muted);">{project.description}</p>
                <div class="flex flex-wrap gap-1.5">
                  {project.technologies.slice(0, 6).map(tech => { const logo = getLogoForSkill(tech); return <span class="tech-tag tech-tag-logo">{logo && <svg viewBox={logo.viewBox ?? '0 0 24 24'} aria-hidden="true" set:html={logo.svgPath} />}{tech}</span>; })}
                </div>
              </div>
              <div class="flex sm:flex-col items-center sm:items-end gap-3 sm:gap-2 shrink-0">
                <span class="text-xs font-mono" style="color: var(--accent);">Case study →</span>
                {project.repositoryLinkEnabled && (
                  <a
                    href={project.repositoryUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-mono accent-hover"
                    style="color: var(--text-muted);"
                  >
                    GitHub ↗
                  </a>
                )}
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Laboratory projects -->
    <section>
      <h2 class="text-xs font-mono uppercase tracking-widest mb-6" style="color: var(--text-muted);">Engineering laboratories</h2>
      <p class="text-sm mb-6" style="color: var(--text-muted);">Focused projects for learning and demonstrating specific backend patterns.</p>
      <div class="grid sm:grid-cols-2 gap-4">
        {labs.map(project => (
          <a
            href={`/projects/${project.slug}/`}
            class="block p-5 rounded-lg transition-colors duration-200"
            style="background: var(--bg-secondary); border: 1px solid var(--border);"
          >
            <div class="flex items-start justify-between gap-2 mb-2">
              <span class="section-label text-xs">{project.categoryLabel}</span>
            </div>
            <h3 class="text-base font-semibold mb-1">{project.title}</h3>
            <p class="text-sm mb-3" style="color: var(--text-secondary);">{project.subtitle}</p>
            <div class="flex flex-wrap gap-1.5">
              {project.technologies.slice(0, 4).map(tech => { const logo = getLogoForSkill(tech); return <span class="tech-tag tech-tag-logo">{logo && <svg viewBox={logo.viewBox ?? '0 0 24 24'} aria-hidden="true" set:html={logo.svgPath} />}{tech}</span>; })}
            </div>
          </a>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
