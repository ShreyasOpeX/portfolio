---
import { achievements, education, leadership } from '../../data/achievements';
---

<section id="achievements" class="container-content py-20">
  <hr class="divider mb-16" />

  <div class="grid lg:grid-cols-2 gap-16">

    <!-- Left: Research + competitive programming -->
    <div>
      <div class="mb-8">
        <p class="section-label mb-3">Recognition</p>
        <h2 class="text-2xl sm:text-3xl font-semibold">Research & achievements</h2>
      </div>

      <div class="space-y-5">
        {achievements.map(a => (
          <div
            class="p-4 rounded-lg"
            style="background: var(--bg-secondary); border: 1px solid var(--border);"
          >
            <div class="flex items-start gap-3">
              <span
                class="font-mono text-xs px-2 py-0.5 rounded mt-0.5 shrink-0"
                style={
                  a.type === 'research'
                    ? 'color: var(--accent); background: var(--bg-elevated); border: 1px solid var(--border);'
                    : a.type === 'competitive'
                    ? 'color: var(--text-secondary); background: var(--bg-elevated); border: 1px solid var(--border);'
                    : 'color: var(--text-muted); background: var(--bg-elevated); border: 1px solid var(--border);'
                }
              >
                {a.type}
              </span>
              <div>
                <p class="text-sm font-medium mb-1" style="color: var(--text-primary);">{a.title}</p>
                <p class="text-sm" style="color: var(--text-secondary);">{a.detail}</p>
                {a.meta && (
                  <p class="text-xs mt-1.5" style="color: var(--text-muted); font-style: italic;">{a.meta}</p>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Right: Education + Leadership -->
    <div>
      {education.map(edu => (
        <div class="mb-10">
          <div class="mb-6">
            <p class="section-label mb-3">Education</p>
            <h2 class="text-2xl sm:text-3xl font-semibold">Academic background</h2>
          </div>
          <div class="p-5 rounded-lg" style="background: var(--bg-secondary); border: 1px solid var(--border);">
            <div class="flex items-start justify-between gap-3 mb-3">
              <div>
                <p class="font-semibold" style="color: var(--text-primary);">{edu.institution}</p>
                <p class="text-sm mt-0.5" style="color: var(--text-secondary);">{edu.degree}</p>
              </div>
              <span class="font-mono text-xs shrink-0 mt-0.5" style="color: var(--text-muted);">{edu.duration}</span>
            </div>
            <div class="flex items-center gap-3 mb-4">
              <span class="font-mono text-sm font-medium" style="color: var(--accent);">{edu.cgpa}</span>
              <span class="text-sm" style="color: var(--text-muted);">CGPA</span>
            </div>
            <div>
              <p class="text-xs font-mono mb-2" style="color: var(--text-muted);">// relevant coursework</p>
              <div class="flex flex-wrap gap-1.5">
                {edu.coursework.map(c => (
                  <span class="tech-tag text-xs">{c}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}

      {leadership.map(l => (
        <div>
          <p class="section-label mb-4">Leadership</p>
          <div class="p-5 rounded-lg" style="background: var(--bg-secondary); border: 1px solid var(--border);">
            <p class="font-semibold mb-0.5" style="color: var(--text-primary);">{l.role}</p>
            <p class="text-sm mb-1" style="color: var(--accent);">{l.organization}</p>
            <p class="text-xs font-mono mb-3" style="color: var(--text-muted);">Since {l.since}</p>
            <ul class="space-y-1.5">
              {l.responsibilities.map(r => (
                <li class="flex items-start gap-2 text-sm" style="color: var(--text-secondary);">
                  <span class="mt-1.5 w-1 h-1 rounded-full shrink-0" style="background: var(--border);"></span>
                  {r}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
