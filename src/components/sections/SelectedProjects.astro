---
import { getFeaturedProjects, getLaboratoryProjects } from '../../data/projects';
import TradeSentryDiagram from '../diagrams/TradeSentryDiagram.astro';
import MediSureArchitecture from '../diagrams/MediSureArchitecture.astro';
import { getLogoForSkill } from '../../data/techLogos';

const featured = getFeaturedProjects();
const labs = getLaboratoryProjects();
---

<section id="projects" class="container-content py-20">
  <hr class="divider mb-16" />

  <div class="mb-12">
    <p class="section-label mb-3">Projects</p>
    <h2 class="text-2xl sm:text-3xl font-semibold">Selected engineering work</h2>
    <p class="mt-3 max-w-xl" style="color: var(--text-secondary);">
      Two flagship projects with deep architectural coverage, plus a set of focused engineering laboratories.
    </p>
  </div>

  <!-- Featured projects -->
  <div class="space-y-16 mb-20">
    {featured.map((project, idx) => (
      <article
        class="rounded-lg overflow-hidden"
        style="border: 1px solid var(--border);"
      >
        <!-- Header band -->
        <div class="p-6 sm:p-8" style="background: var(--bg-secondary);">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-4">
            <div>
              <span class="section-label text-xs">{project.categoryLabel}</span>
              <h3 class="text-xl sm:text-2xl font-semibold mt-2">{project.title}</h3>
              <p class="mt-1 text-base" style="color: var(--text-secondary);">{project.subtitle}</p>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              {project.repositoryLinkEnabled && (
                <a
                  href={project.repositoryUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-mono px-3 py-1.5 rounded transition-colors duration-200"
                  style="border: 1px solid var(--border); color: var(--text-muted); background: var(--bg-elevated);"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                  Source
                </a>
              )}
              <a
                href={`/projects/${project.slug}/`}
                class="inline-flex items-center gap-1.5 text-xs font-mono px-3 py-1.5 rounded transition-colors duration-200"
                style="border: 1px solid var(--accent); color: var(--accent); background: transparent;"
              >
                Case study
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>

          <p class="text-sm leading-relaxed mb-5" style="color: var(--text-secondary);">{project.description}</p>

          <!-- Tech tags -->
          <div class="flex flex-wrap gap-2">
            {project.technologies.map(tech => { const logo = getLogoForSkill(tech); return <span class="tech-tag tech-tag-logo">{logo && <svg viewBox={logo.viewBox ?? '0 0 24 24'} aria-hidden="true" set:html={logo.svgPath} />}{tech}</span>; })}
          </div>
        </div>

        <!-- Architecture diagram -->
        <div class="p-6 sm:p-8" style="background: var(--bg-elevated);">
          <p class="text-xs font-mono mb-4" style="color: var(--text-muted);">// architecture overview</p>
          {idx === 0 && <TradeSentryDiagram />}
          {idx === 1 && <MediSureArchitecture compact />}
        </div>

        <!-- Engineering highlights -->
        <div class="p-6 sm:p-8" style="background: var(--bg-base); border-top: 1px solid var(--border);">
          <p class="text-xs font-mono mb-4" style="color: var(--text-muted);">// engineering decisions</p>
          <div class="grid sm:grid-cols-2 gap-x-8 gap-y-2">
            {project.engineeringHighlights.map(h => (
              <div class="flex items-start gap-2 text-sm" style="color: var(--text-secondary);">
                <span class="mt-1.5 w-1 h-1 rounded-full shrink-0" style="background: var(--accent);"></span>
                {h}
              </div>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- Engineering laboratories -->
  <div class="mb-6">
    <p class="section-label mb-3">Engineering Laboratories</p>
    <p class="text-sm" style="color: var(--text-muted);">
      Focused projects for learning and demonstrating specific backend patterns.
    </p>
  </div>

  <div class="grid sm:grid-cols-2 gap-5">
    {labs.map(project => (
      <article class="card p-5 flex flex-col">
        <div class="flex items-start justify-between gap-2 mb-3">
          <div>
            <span class="font-mono text-xs" style="color: var(--accent);">{project.categoryLabel}</span>
            <h3 class="text-base font-semibold mt-1">{project.title}</h3>
          </div>
        </div>
        <p class="text-sm leading-relaxed mb-4 flex-1" style="color: var(--text-secondary);">{project.subtitle}</p>
        <div class="flex flex-wrap gap-1.5 mb-4">
          {project.technologies.slice(0, 5).map(tech => { const logo = getLogoForSkill(tech); return <span class="tech-tag tech-tag-logo">{logo && <svg viewBox={logo.viewBox ?? '0 0 24 24'} aria-hidden="true" set:html={logo.svgPath} />}{tech}</span>; })}
        </div>
        <div class="flex items-center gap-3 mt-auto">
          <a
            href={`/projects/${project.slug}/`}
            class="text-xs font-mono accent-hover"
            style="color: var(--text-muted);"
          >
            Read more →
          </a>
          {project.repositoryLinkEnabled && (
            <a
              href={project.repositoryUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-mono accent-hover"
              style="color: var(--text-muted);"
            >
              GitHub ↗
            </a>
          )}
        </div>
      </article>
    ))}
  </div>

  <!-- View all link -->
  <div class="mt-8 text-center">
    <a
      href="/projects/"
      class="inline-flex items-center gap-2 text-sm transition-colors duration-200"
      style="color: var(--text-secondary);"
    >
      View all projects
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</section>
