---
import { getLogoForSkill, techLogos, type TechLogo } from '../../data/techLogos';

const entryNodes = [
  { name: 'REST API intake', sub: 'POST /api/transactions', logo: 'REST APIs', kind: 'sync' },
  { name: 'Spring Security', sub: 'authentication · RBAC', logo: 'Spring Security', kind: 'security' },
  { name: 'core-service', sub: 'validation · rate limiting', logo: 'Spring Boot', kind: 'service' },
];
const persistenceNodes = [
  { name: 'PostgreSQL', sub: 'transactions · cases · audit', logo: 'PostgreSQL', kind: 'store' },
  { name: 'Transactional outbox', sub: 'atomic DB + publish intent', logo: 'Transactional outbox', kind: 'store' },
  { name: 'Outbox relay', sub: 'durable event publishing', logo: 'Apache Kafka', kind: 'async' },
];
const eventNodes = [
  { name: 'transactions.ingested', sub: 'accountId partition key', logo: 'Apache Kafka', kind: 'async' },
  { name: 'transactions.flagged', sub: 'screening · investigation', logo: 'Apache Kafka', kind: 'async' },
  { name: 'transactions.adjudicated', sub: 'decision · case · audit', logo: 'Apache Kafka', kind: 'async' },
  { name: 'DLQ + retry topics', sub: 'bounded retries · recovery', logo: 'Dead-letter topics', kind: 'error' },
];
const investigationNodes = [
  { name: 'Rule-screening engine', sub: 'deterministic AML rules', logo: 'Java', kind: 'async' },
  { name: 'Investigation agent', sub: 'bounded Java StateGraph', logo: 'Java', kind: 'ai' },
  { name: 'Risk + adjudication', sub: 'score · CLEAR / FLAG / ESCALATE', logo: 'Spring Boot', kind: 'service' },
];
const outputNodes = [
  { name: 'case-data-service', sub: 'gRPC · history + similar cases', logo: 'gRPC', kind: 'sync' },
  { name: 'Case management', sub: 'investigation_cases · SAR workflow', logo: 'Spring Boot', kind: 'service' },
  { name: 'Independent audit consumer', sub: 'consumer group · audit_records', logo: 'Apache Kafka', kind: 'async' },
];
const logoFor = (name: string): TechLogo => getLogoForSkill(name) ?? techLogos.pattern;
---

<section class="ms-architecture ts-architecture" aria-label="TradeSentry system architecture">
  <div class="ms-arch-head">
    <div><p class="section-label mb-2">System architecture</p><h3 class="text-base sm:text-lg font-semibold">TradeSentry event-driven topology</h3></div>
    <div class="ms-arch-legend"><span class="ms-legend-sync">→ sync / REST / gRPC</span><span class="ms-legend-async">⇢ async / Kafka</span><span class="ms-legend-storage">● database</span><span class="ms-legend-error">↝ retry / DLQ</span></div>
  </div>

  <div class="ms-arch-body">
    <div class="ms-arch-row ms-entry-row ts-entry-row">
      {entryNodes.map(node => { const logo = logoFor(node.logo); return <div class:list={["ms-arch-node", `ms-node-${node.kind}`]}>
        <span class="ms-tech-logo"><svg viewBox={logo.viewBox ?? '0 0 24 24'} aria-hidden="true" set:html={logo.svgPath} /></span>
        <span><strong>{node.name}</strong><small>{node.sub}</small></span>
      </div>; })}
    </div>
    <div class="ms-arch-rail ms-rail-sync"><span>authenticated · authorized · rate-limited HTTP boundary</span></div>

    <div class="ms-arch-columns ts-arch-columns">
      <div class="ms-arch-column">
        <p class="ms-arch-label"><span>01</span> persistence + publish <em>atomic</em></p>
        <div class="ms-arch-stack">{persistenceNodes.map(node => { const logo = logoFor(node.logo); return <div class:list={["ms-arch-node", "ms-node-pipeline", `ms-node-${node.kind}`]}>
          <span class="ms-tech-logo"><svg viewBox={logo.viewBox ?? '0 0 24 24'} aria-hidden="true" set:html={logo.svgPath} /></span><span><strong>{node.name}</strong><small>{node.sub}</small></span>
        </div>; })}</div>
      </div>
      <div class="ms-arch-column ts-event-column">
        <p class="ms-arch-label"><span>02</span> Kafka event backbone <em>async</em></p>
        <div class="ms-arch-flow ts-event-flow">{eventNodes.map((node, index) => { const logo = logoFor(node.logo); return <div class="ms-arch-flow-item"><div class:list={["ms-arch-node", "ms-node-pipeline", `ms-node-${node.kind}`]}>
          <span class="ms-tech-logo"><svg viewBox={logo.viewBox ?? '0 0 24 24'} aria-hidden="true" set:html={logo.svgPath} /></span><span><strong>{node.name}</strong><small>{node.sub}</small></span>
        </div>{index < eventNodes.length - 1 && <span class:list={["ms-flow-arrow", node.kind === 'error' ? "ts-error-arrow" : "ms-async-arrow"]}>⇢</span>}</div>; })}</div>
      </div>
      <div class="ms-arch-column">
        <p class="ms-arch-label"><span>03</span> screening + investigation <em>workflow</em></p>
        <div class="ms-arch-stack">{investigationNodes.map(node => { const logo = logoFor(node.logo); return <div class:list={["ms-arch-node", "ms-node-query", `ms-node-${node.kind}`]}>
          <span class="ms-tech-logo"><svg viewBox={logo.viewBox ?? '0 0 24 24'} aria-hidden="true" set:html={logo.svgPath} /></span><span><strong>{node.name}</strong><small>{node.sub}</small></span>
        </div>; })}</div>
      </div>
    </div>

    <div class="ms-arch-branch-label ts-branch-label"><span>typed service read + adjudication outputs</span></div>
    <div class="ms-arch-lower-grid ts-lower-grid">
      <div class="ms-arch-panel"><p class="ms-arch-label"><span>04</span> synchronous case data</p><div class="ms-arch-stack">{outputNodes.slice(0, 1).map(node => { const logo = logoFor(node.logo); return <div class:list={["ms-arch-node", `ms-node-${node.kind}`]}><span class="ms-tech-logo"><svg viewBox={logo.viewBox ?? '0 0 24 24'} aria-hidden="true" set:html={logo.svgPath} /></span><span><strong>{node.name}</strong><small>{node.sub}</small></span></div>; })}</div></div>
      <div class="ms-arch-panel"><p class="ms-arch-label"><span>05</span> decisions + durable records</p><div class="ms-store-grid ts-output-grid">{outputNodes.slice(1).map(node => { const logo = logoFor(node.logo); return <div class:list={["ms-arch-node", `ms-node-${node.kind}`]}><span class="ms-tech-logo"><svg viewBox={logo.viewBox ?? '0 0 24 24'} aria-hidden="true" set:html={logo.svgPath} /></span><span><strong>{node.name}</strong><small>{node.sub}</small></span></div>; })}</div></div>
    </div>
  </div>

  <p class="ms-arch-note"><span>→</span> REST handles authenticated intake and policy enforcement. <span>⇢</span> Kafka separates screening, investigation, case management and independent audit consumers. <span>↝</span> Idempotent inboxes, bounded retries and dead-letter topics preserve recoverability.</p>
</section>
