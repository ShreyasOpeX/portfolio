---
import { navLinks } from '../../data/navigation';
import { profile } from '../../data/profile';

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="sticky top-0 z-50 w-full"
  style="background: color-mix(in srgb, var(--bg-base) 88%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); position: relative;"
>
  <nav
    class="container-content flex items-center justify-between h-14"
    aria-label="Main navigation"
  >
    <!-- Wordmark -->
    <a
      href="/"
      class="font-mono text-sm font-medium transition-colors duration-200"
      style="color: var(--text-primary); letter-spacing: -0.01em;"
      aria-label="Shreyas — home"
    >
      {profile.wordmark}
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-6">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="nav-link"
          aria-current={currentPath === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}

      <!-- GitHub -->
      <a
        href={profile.github}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors duration-200"
        style="color: var(--text-secondary);"
        aria-label="GitHub profile"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      </a>

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        type="button"
        class="transition-colors duration-200 p-1 rounded"
        style="color: var(--text-secondary);"
        aria-label="Toggle color theme"
        onclick="window.__toggleTheme && window.__toggleTheme()"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display:none">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      type="button"
      class="md:hidden p-2 rounded transition-colors duration-200"
      style="color: var(--text-secondary);"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="menu-open" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg id="menu-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display:none">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t"
    style="border-color: var(--border); background: var(--bg-base);"
    role="dialog"
    aria-label="Navigation menu"
  >
    <div class="container-content py-4 flex flex-col gap-1">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="nav-link py-2.5 border-b text-base"
          style="border-color: var(--bg-elevated);"
          aria-current={currentPath === link.href ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <div class="flex items-center gap-4 pt-3">
        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm transition-colors duration-200"
          style="color: var(--text-secondary);"
        >
          GitHub
        </a>
        <button
          type="button"
          class="text-sm transition-colors duration-200"
          style="color: var(--text-secondary);"
          onclick="window.__toggleTheme && window.__toggleTheme()"
        >
          Toggle theme
        </button>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const open = document.getElementById('menu-open');
    const close = document.getElementById('menu-close');
    const sun = document.getElementById('icon-sun');
    const moon = document.getElementById('icon-moon');

    function updateIcons() {
      const isLight = document.documentElement.classList.contains('light');
      if (sun) sun.style.display = isLight ? 'none' : 'block';
      if (moon) moon.style.display = isLight ? 'block' : 'none';
    }

    updateIcons();

    const origToggle = window.__toggleTheme;
    window.__toggleTheme = function () {
      origToggle && origToggle();
      updateIcons();
    };

    btn && btn.addEventListener('click', function () {
      const isOpen = menu && !menu.classList.contains('hidden');
      if (menu) menu.classList.toggle('hidden');
      if (open) open.style.display = isOpen ? 'block' : 'none';
      if (close) close.style.display = isOpen ? 'none' : 'block';
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  })();
</script>
